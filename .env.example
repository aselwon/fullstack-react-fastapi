# Local demo only. Set strong independent secrets before any external deployment.
POSTGRES_USER=relaydesk
POSTGRES_PASSWORD=relaydesk-local
POSTGRES_DB=relaydesk
JWT_SECRET=local-development-only-change-before-deploying
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
API_PORT=8000
WEB_PORT=3000
# Required only for the internal demo webhook receiver. Disable for public deployment.
WEBHOOK_ALLOW_PRIVATE=true
# Non-Docker development (run from apps/api):
# DATABASE_URL=sqlite:///./relaydesk.db
# REDIS_URL=redis://localhost:6379/0
# UPLOAD_DIR=./uploads
